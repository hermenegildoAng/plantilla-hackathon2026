# ==========================================================
# Django
# ==========================================================
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=django-insecure-development-only-change-me
DJANGO_DEBUG=True
# Coma-separados. En producción usa únicamente tus dominios reales.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ==========================================================
# PostgreSQL 16 (los valores coinciden con docker-compose)
# ==========================================================
DB_NAME=hackathon_db
DB_USER=hackathon_user
DB_PASSWORD=hackathon_password
# En Docker Compose se sobrescribe a "db"; fuera de Docker usa localhost.
DB_HOST=localhost
DB_PORT=5432

# ==========================================================
# CORS / CSRF (Vite dev server)
# ==========================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
